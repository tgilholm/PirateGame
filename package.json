{
  "name": "poopdeck-pirates",
  "version": "1.0.0",
  "description": "A multiplayer pirate game with server-side physics",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server.js",
    "build:shared": "tsc -p shared/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "npm run build:shared && npm run build:server"
  },
  "dependencies": {
    "express": "^4.18.2",
    "matter-js": "^0.20.0",
    "nodemon": "^3.0.1",
    "phaser": "^3.90.0",
    "poly-decomp-es": "^0.4.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/socket.io-client": "^1.4.36",
    "undici-types": "^7.22.0"
  }
}
