{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"rootDir": "./src",
		"outDir": "./built",
		"baseUrl": ".",
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"paths": {
			"@shared/*": ["../shared/built/*"]
		}
	},
	"references": [{ "path": "../shared" }],

	"include": ["src/**/*"]
}
